load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@direct_pip//:requirements.bzl", "requirement")
load("@nanobind_bazel//:build_defs.bzl", "nanobind_extension")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "_gaussian_fill_impl",
    hdrs = ["_gaussian_fill_impl.h"],
    # Expose the header under its workspace-relative path so consumers can
    # use `#include "direct/ssl/_gaussian_fill_impl.h"`.
    strip_include_prefix = "/",
    visibility = ["//direct:__subpackages__"],
    deps = ["//direct/common:rng"],
)

nanobind_extension(
    name = "_gaussian_fill",
    srcs = ["_gaussian_fill.cpp"],
    copts = ["-std=c++20"],
    deps = [":_gaussian_fill_impl"],
)

py_library(
    name = "ssl",
    srcs = glob(["**/*.py"]),
    data = [
        ":_gaussian_fill",
    ],
    deps = [
        requirement("numpy"),
        requirement("torch"),
    ],
)
